# RevPilot AI — Environment Configuration

# Backend Configuration
DATABASE_URL=sqlite:///./revpilot.db
SECRET_KEY=change-this-in-production-revpilot-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AS_OF_DATE=2026-10-20T00:00:00Z
